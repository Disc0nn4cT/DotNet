<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:YachtCatalog.ViewModels"
             xmlns:models="clr-namespace:YachtCatalog.Models"
             xmlns:converters="clr-namespace:YachtCatalog.Converters"
             x:Class="YachtCatalog.MainPage"
             x:DataType="vm:CatalogViewModel"
             Title="Яхт-чартер «Вітрило» · REST API"
             BackgroundColor="{StaticResource PageBackground}">
    <ContentPage.Resources>
        <converters:HasTextConverter x:Key="HasText" />
        <converters:NotBoolConverter x:Key="NotBool" />
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Змінити акцент" Clicked="OnAccentClicked" />
    </ContentPage.ToolbarItems>
    <Grid Padding="20" RowDefinitions="Auto,Auto,170,*" RowSpacing="12"
          MaximumWidthRequest="680" HorizontalOptions="Fill">
        <VerticalStackLayout Spacing="6">
            <Label Text="⛵ Яхт-чартер «Вітрило»" Style="{StaticResource HeadingLabel}" />
            <Label Text="{Binding ProductCountText}" TextColor="{StaticResource MutedColor}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Додати «Хвилю»" Command="{Binding AddDemoProductCommand}" />
                <Button Grid.Column="1" Text="Прибрати яхту"
                        Command="{Binding RemoveSelectedCommand}"
                        BackgroundColor="#D6EAF2" TextColor="{StaticResource AccentColor}" />
            </Grid>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="6">
            <Label Text="{Binding NetworkStatus}" FontSize="14" />
            <Entry Text="{Binding ApiPath, Mode=TwoWay}" IsEnabled="{Binding IsLoading, Converter={StaticResource NotBool}}"
                   SemanticProperties.Description="Маршрут демонстраційного API" />
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                <Button Text="Завантажити з API" Command="{Binding LoadCatalogCommand}" />
                <Button Grid.Column="1" Text="Скасувати запит" Command="{Binding CancelLoadCommand}" />
                <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsLoading}" />
            </Grid>
        </VerticalStackLayout>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Products}"
                        SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                        SelectionMode="Single">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Text="Каталог порожній. Завантажте інший каталог або додайте «Хвилю»."
                       VerticalOptions="Center" HorizontalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <Border WidthRequest="190" Padding="12" Margin="0,4"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="#C9DCE6" StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="#C9DCE6" />
                                        <Setter Property="StrokeThickness" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="{StaticResource AccentColor}" />
                                        <Setter Property="StrokeThickness" Value="3" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <VerticalStackLayout Spacing="6">
                            <Image Source="{Binding ImageName}" HeightRequest="70" Aspect="AspectFit"
                                   SemanticProperties.Description="{Binding ImageDescription}" />
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="17"
                                   MaxLines="1" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding PriceText}" FontSize="14" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ScrollView Grid.Row="3">
            <VerticalStackLayout Spacing="12">
                <Border BackgroundColor="{StaticResource CardBackground}"
                        Stroke="#C9DCE6" Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Image Source="{Binding SelectedImageName}" HeightRequest="110" Aspect="AspectFit"
                               IsVisible="{Binding HasSelection}"
                               SemanticProperties.Description="{Binding SelectedImageDescription}" />
                        <Label Text="{Binding SelectedName}" FontSize="24" FontAttributes="Bold" />
                        <Label Text="{Binding SelectedDescription}" TextColor="{StaticResource MutedColor}" />
                        <Label Text="{Binding SelectedPriceText}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,100" ColumnSpacing="12">
                    <Label Text="{Binding QuantityHint}" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Text="{Binding QuantityText, Mode=TwoWay}"
                           Keyboard="Numeric" MaxLength="6" IsEnabled="{Binding HasSelection}"
                           HorizontalTextAlignment="Center"
                           SemanticProperties.Description="Кількість діб оренди" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <CheckBox IsChecked="{Binding IncludeOption, Mode=TwoWay}"
                              IsEnabled="{Binding HasSelection}" />
                    <Label Grid.Column="1" Text="{Binding SelectedOptionText}" VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="Розрахувати" Command="{Binding CalculateCommand}" />
                    <Button Grid.Column="1" Text="Скинути вибір" Command="{Binding ResetCommand}"
                            BackgroundColor="#D6EAF2" TextColor="{StaticResource AccentColor}" />
                </Grid>
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorColor}"
                       IsVisible="{Binding ErrorMessage, Mode=OneWay, Converter={StaticResource HasText}}" />
                <Label Text="{Binding ResultText}" FontSize="22" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="Зберегти вибір" Command="{Binding SaveSelectionCommand}" />
                    <Button Grid.Column="1" Text="Збережені оренди" Command="{Binding OpenSavedCommand}" />
                </Grid>
                <Label Text="Каталог — у пам’яті. Збережений вибір — у SQLite, навіть після перезапуску."
                       FontSize="14" TextColor="{StaticResource MutedColor}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
