<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Морська палітра каталогу -->
    <Color x:Key="PageBackground">#EAF5FA</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="AccentColor">#0B2F4A</Color>
    <Color x:Key="SecondaryColor">#138A8A</Color>
    <Color x:Key="TextColor">#1F2D3A</Color>
    <Color x:Key="MutedColor">#4A5B69</Color>
    <Color x:Key="ErrorColor">#B42318</Color>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="HeadingLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource MutedColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource AccentColor}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource SecondaryColor}" />
    </Style>
</ResourceDictionary>
