@page
@model LoginModel
@{
    ViewData["Title"] = "Вхід";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1>@ViewData["Title"]</h1>
        <form id="account" method="post">
            <p class="text-muted">Увійдіть, щоб залишати оцінки й відгуки.</p>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password"></label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe"></label>
            </div>
            <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Увійти</button>
            <p class="mt-3">
                Немає облікового запису?
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Зареєструватися</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}