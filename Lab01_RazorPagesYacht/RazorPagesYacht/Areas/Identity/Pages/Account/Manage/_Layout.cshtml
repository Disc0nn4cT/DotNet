@{
    // Account pages are shown inside the main site layout (menu, footer)
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<h1>Мій обліковий запис</h1>
<div>
    <h2 class="h5 text-muted">Налаштування облікового запису</h2>
    <hr />
    <div class="row">
        <div class="col-md-3 mb-3">
            <partial name="_ManageNav" />
        </div>
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}