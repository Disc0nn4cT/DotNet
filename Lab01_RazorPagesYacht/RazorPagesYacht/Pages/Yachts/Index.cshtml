@page
@model RazorPagesYacht.Pages.Yachts.IndexModel


@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<form>
    <p>
        <select asp-for="YachtCategory" asp-items="Model.Categories">
            <option value="">All</option>
        </select>
        <label>Name: <input type="text" asp-for="SearchString" /></label>
        <input type="submit" value="Filter" />
    </p>
</form>
<table class="table">
    <thead>
        <tr>

            <th>
                @Html.DisplayNameFor(model => model.Yacht[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Yacht[0].Shipyard)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Yacht[0].Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Yacht[0].LaunchDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Yacht[0].Price)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Yacht[0].Length)
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Yacht) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Shipyard)
            </td>
            <td>
                @Html.DisplayFor(model => item.Category)
            </td>
            <td>
                @Html.DisplayFor(model => item.LaunchDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.Price)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Length)
                </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
