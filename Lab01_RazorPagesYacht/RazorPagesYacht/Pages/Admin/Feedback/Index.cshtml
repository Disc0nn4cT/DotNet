@page
@model RazorPagesYacht.Pages.Admin.Feedback.IndexModel
@{
    ViewData["Title"] = "Звернення (адмін)";
}

<h1 class="mb-3">@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(Model.OkMessage))
{
    <div class="alert alert-success">@Model.OkMessage</div>
}

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-12 col-md-6">
        <label for="Q" class="form-label">Пошук</label>
        <input id="Q" name="Q" value="@Model.Q" class="form-control" placeholder="Ім’я, email, тема або текст" />
    </div>
    <div class="col-6 col-md-3">
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="OnlyUnreplied"
                   name="OnlyUnreplied" value="true" @(Model.OnlyUnreplied ? "checked" : "") />
            <label class="form-check-label" for="OnlyUnreplied">Лише без відповіді</label>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <button class="btn btn-primary w-100">Фільтр</button>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">Звернень не знайдено.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Дата</th>
                    <th>Від</th>
                    <th>Email</th>
                    <th>Тема</th>
                    <th>Повідомлення</th>
                    <th>Статус</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var it in Model.Items)
                {
                    <tr>
                        <td><small class="text-muted">@it.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
                        <td>@it.Name</td>
                        <td><a href="mailto:@it.Email">@it.Email</a></td>
                        <td>@it.Subject</td>
                        <td style="max-width:360px">@it.Message</td>
                        <td>
                            @if (it.RepliedAt != null)
                            {
                                <span class="badge text-bg-success">Відповіли</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">Без відповіді</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="./Reply" asp-route-id="@it.Id">
                                @(it.RepliedAt != null ? "Переглянути" : "Відповісти")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}