@page "{id:int}"
@model RazorPagesYacht.Pages.Admin.Yachts.DetailsModel
@{
    ViewData["Title"] = Model.Yacht.Name;
}

<h1>@Model.Yacht.Name</h1>
<hr />
<div class="row g-4">
    <div class="col-md-4">
        <img src="@(string.IsNullOrEmpty(Model.Yacht.PhotoPath) ? Url.Content("~/images/placeholder-yacht.svg") : Url.Content(Model.Yacht.PhotoPath))"
             class="img-fluid rounded border" alt="Фото @Model.Yacht.Name" style="object-fit:cover; aspect-ratio:4/3;" />
    </div>
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Yacht.Shipyard)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Yacht.Shipyard)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Yacht.Category)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Yacht.Category)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Yacht.LaunchDate)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Yacht.LaunchDate)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Yacht.Price)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Yacht.Price)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Yacht.Length)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Yacht.Length)</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-page="./Edit" asp-route-id="@Model.Yacht.Id" class="btn btn-primary">Редагувати</a>
    <a asp-page="./Index" class="btn btn-outline-secondary">До списку</a>
    <a asp-page="/Catalog/Details" asp-route-id="@Model.Yacht.Id" class="btn btn-link">Відкрити в каталозі</a>
</div>