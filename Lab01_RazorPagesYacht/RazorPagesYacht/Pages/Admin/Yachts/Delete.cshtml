@page "{id:int}"
@model RazorPagesYacht.Pages.Admin.Yachts.DeleteModel
@{
    ViewData["Title"] = "Видалення яхти";
}

<h1>@ViewData["Title"]</h1>
<div class="alert alert-warning">
    Ви впевнені, що хочете видалити яхту <strong>@Model.Yacht.Name</strong>?
    Разом із нею буде видалено фото та всі відгуки.
</div>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Yacht.Shipyard)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Yacht.Shipyard)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Yacht.Category)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Yacht.Category)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Yacht.LaunchDate)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Yacht.LaunchDate)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Yacht.Price)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Yacht.Price)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Yacht.Length)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Yacht.Length)</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Yacht.Id" />
    <button type="submit" class="btn btn-danger">Видалити</button>
    <a asp-page="./Index" class="btn btn-outline-secondary">Скасувати</a>
</form>