@page "{id:int}"
@model RazorPagesYacht.Pages.Admin.Yachts.EditModel
@{
    ViewData["Title"] = "Редагування яхти";
}

<h1>Редагування яхти</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Yacht.Id" />
            <input type="hidden" asp-for="Yacht.PhotoPath" />
            <div class="form-group">
                <label asp-for="Yacht.Name" class="control-label"></label>
                <input asp-for="Yacht.Name" class="form-control" />
                <span asp-validation-for="Yacht.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Yacht.Shipyard" class="control-label"></label>
                <input asp-for="Yacht.Shipyard" class="form-control" />
                <span asp-validation-for="Yacht.Shipyard" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Yacht.Category" class="control-label"></label>
                <input asp-for="Yacht.Category" class="form-control" />
                <span asp-validation-for="Yacht.Category" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Yacht.LaunchDate" class="control-label"></label>
                <input asp-for="Yacht.LaunchDate" class="form-control" />
                <span asp-validation-for="Yacht.LaunchDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Yacht.Price" class="control-label"></label>
                <input asp-for="Yacht.Price" class="form-control" />
                <span asp-validation-for="Yacht.Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Yacht.Length" class="control-label"></label>
                <input asp-for="Yacht.Length" class="form-control" />
                <span asp-validation-for="Yacht.Length" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <label class="control-label d-block">Поточне фото</label>
                <img src="@(string.IsNullOrEmpty(Model.Yacht.PhotoPath) ? Url.Content("~/images/placeholder-yacht.svg") : Url.Content(Model.Yacht.PhotoPath))"
                     class="img-fluid rounded border" style="max-width:240px; object-fit:cover; aspect-ratio:4/3;" />
            </div>
            <div class="form-group">
                <label class="control-label">Замінити фото (jpg/png/webp, до 2 МБ)</label>
                <input asp-for="PhotoFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                <span asp-validation-for="PhotoFile" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Зберегти" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}