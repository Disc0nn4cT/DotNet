@page "/"
@inject CatalogService Catalog
@inject OrderState Order
@inject ILogger<Home> Logger

<PageTitle>Каталог · Яхт-чартер «Вітрило»</PageTitle>

<section class="hero">
    <p class="eyebrow">Оренда яхт · Чорне море</p>
    <h1>Яхт-чартер «Вітрило»</h1>
    <p>Оберіть яхту, тривалість оренди та екіпаж і зберіть свою флотилію.</p>
</section>

<div class="shop-grid">
    <section aria-label="Каталог яхт">
        <div class="section-heading"><h2>Наш флот</h2><span>6 яхт для будь-якого маршруту</span></div>
        @if (error is not null)
        {
            <p role="alert" class="state-message error">@error</p>
            <button type="button" @onclick="LoadAsync">Спробувати ще</button>
        }
        else if (yachts is null)
        {
            <p role="status" class="state-message">Завантаження каталогу…</p>
        }
        else if (yachts.Count == 0)
        {
            <p class="state-message">Каталог поки що порожній.</p>
        }
        else
        {
            <div class="catalog">
                @foreach (var yacht in yachts)
                {
                    <YachtCard @key="yacht.Id" Yacht="yacht" OnSelect="SelectYacht" />
                }
            </div>
        }
    </section>
    <CartSummary />
</div>

@if (selectedYacht is not null)
{
    <ConfigureYachtDialog @key="selectedYacht.Id" Yacht="selectedYacht"
                          OnCancel="CloseDialog" OnConfirm="ConfirmYacht" />
}

@code {
    private List<Yacht>? yachts;      // null = ще завантажується
    private Yacht? selectedYacht;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        yachts = null;
        try
        {
            yachts = await Catalog.GetYachtsAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Не вдалося завантажити каталог");
            error = "Не вдалося завантажити каталог. Перевірте сервер і спробуйте ще раз.";
        }
    }

    private void SelectYacht(Yacht yacht) => selectedYacht = yacht;
    private void CloseDialog() => selectedYacht = null;

    private void ConfirmYacht(OrderLine line)
    {
        Order.Add(line);   // замість lastSelection — додаємо в спільний кошик
        CloseDialog();
    }
}
