@page "/orders"
@inject PurchaseService Purchases
@inject ILogger<Orders> Logger

<PageTitle>Навчальні замовлення · Яхт-чартер «Вітрило»</PageTitle>
<h1>Навчальні замовлення</h1>
<p>Це спільний демонстраційний список без облікових записів. Не вводьте реальні персональні дані.</p>
@if (error is not null)
{
    <p role="alert" class="state-message error">@error</p>
    <button @onclick="LoadAsync">Повторити</button>
}
else if (orders is null) { <p role="status" class="state-message">Завантаження…</p> }
else if (orders.Count == 0) { <p class="state-message">Замовлень ще немає. <a href="/">Відкрити каталог</a></p> }
else
{
    <div class="orders-list">
        <PagedList TItem="PurchaseOrder" Items="orders" PageSize="3">
            <ItemTemplate Context="order">
            <article class="panel order-card" @key="order.Id">
                <h2><a href="@($"/orders/{order.Id}")">Замовлення №@order.Id</a></h2>
                <p>@order.CreatedUtc.ToString("dd.MM.yyyy HH:mm") UTC · позицій: @order.Items.Count · яхт: @order.Items.Sum(i => i.Quantity)</p>
                <strong><MoneyLabel Amount="order.Total" /></strong>
            </article>
            </ItemTemplate>
        </PagedList>
    </div>
}

@code {
    private List<PurchaseOrder>? orders;   // null = завантаження
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        orders = null;
        try { orders = await Purchases.GetAllAsync(); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Не вдалося отримати замовлення");
            error = "Не вдалося отримати список. Перевірте сервер.";
        }
    }
}
