@page "/orders/{Id:int}"
@inject PurchaseService Purchases
@inject ILogger<OrderDetails> Logger

<PageTitle>Замовлення №@Id · Яхт-чартер «Вітрило»</PageTitle>
<h1>Замовлення №@Id</h1>
@if (error is not null) { <p role="alert" class="state-message error">@error</p> }
else if (loading) { <p role="status" class="state-message">Завантаження…</p> }
else if (order is null) { <p class="state-message">Такого замовлення немає.</p> }
else
{
    <article class="panel">
        <p>Створено: @order.CreatedUtc.ToString("dd.MM.yyyy HH:mm") UTC</p>
        <ul class="review-lines">
            @foreach (var item in order.Items)
            {
                <li @key="item.Id">
                    <strong>@item.ProductName</strong>
                    <span>@item.Options · яхт: @item.Quantity</span>
                    <MoneyLabel Amount="item.Total" />
                </li>
            }
        </ul>
        <p class="review-total">Разом: <MoneyLabel Amount="order.Total" /></p>
        <p>Замовлення збережено. Оплата не проводилася.</p>
        <LiveOrderStatus @key="order.Id" CreatedUtc="order.CreatedUtc" />
        <OrderTools @key="order.Id" Summary="@($"Яхт-чартер «Вітрило» — замовлення №{order.Id}, яхт: {order.Items.Sum(i => i.Quantity)}, {order.Total:N2} грн. Оплати не було.")" />
        @if (!string.IsNullOrEmpty(order.CustomerName))
        {
            <h2>Клієнт і прибуття</h2>
            <p>@order.CustomerName · @order.Phone</p>
            <p>@(string.IsNullOrEmpty(order.DeliveryAddress) ? "Самостійно до марини" : $"Трансфер з адреси: {order.DeliveryAddress}")</p>
            @if (!string.IsNullOrEmpty(order.Comment)) { <p class="order-comment">@order.Comment</p> }
        }
    </article>
}
<a class="back-link" href="/orders">До списку замовлень</a>

@code {
    // Значення з адреси /orders/12 маршрутизатор записує в цю властивість.
    [Parameter] public int Id { get; set; }

    private PurchaseOrder? order;
    private bool loading = true;
    private string? error;
    private int loadVersion;

    // Викликається і при першому відкритті, і коли той самий компонент отримує інший Id.
    protected override async Task OnParametersSetAsync()
    {
        var version = ++loadVersion;
        loading = true;
        error = null;
        order = null;
        try
        {
            var result = await Purchases.GetAsync(Id);
            if (version == loadVersion) order = result;   // ігноруємо застарілий результат
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Не вдалося отримати замовлення {Id}", Id);
            if (version == loadVersion) error = "Помилка читання даних. Це не означає, що замовлення відсутнє.";
        }
        finally { if (version == loadVersion) loading = false; }
    }
}
