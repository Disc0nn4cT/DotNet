@implements IAsyncDisposable

<div class="status-panel" role="status">
    <strong>@status</strong>
    <p>Навчальна імітація: 0–15 с — заявку прийнято; 15–30 с — яхту готують; далі — яхта чекає біля причалу.</p>
    <small>Це не реальне відстеження марини чи екіпажу. Перевірка кожні 3 секунди.</small>
</div>

@code {
    [Parameter] public DateTime CreatedUtc { get; set; }
    private readonly CancellationTokenSource stop = new();
    private Task? loop;
    private string status = "";

    protected override void OnInitialized()
    {
        UpdateStatus();
        loop = RunAsync();   // зберігаємо задачу, щоб дочекатися її в DisposeAsync
    }

    private void UpdateStatus() => status = DemoOrderProgress.GetStatus(CreatedUtc, DateTime.UtcNow);

    private async Task RunAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (!DemoOrderProgress.IsComplete(CreatedUtc, DateTime.UtcNow)
                && await timer.WaitForNextTickAsync(stop.Token))
            {
                // Зміна прийшла від таймера, а не від UI-події, тому StateHasChanged через InvokeAsync.
                await InvokeAsync(() => { UpdateStatus(); StateHasChanged(); });
            }
        }
        catch (OperationCanceledException) when (stop.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        stop.Cancel();
        if (loop is not null) await loop;
        stop.Dispose();
    }
}
