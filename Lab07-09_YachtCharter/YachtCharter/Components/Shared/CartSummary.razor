@implements IDisposable
@inject OrderState Order
@inject IJSRuntime JS

<aside class="cart" aria-label="Кошик">
    <span class="eyebrow">Ваша флотилія</span>
    <h2>Кошик <span class="count">@Order.Count</span></h2>
    @if (Order.Items.Count == 0)
    {
        <p class="empty-cart">Оберіть яхту в каталозі.<br />Вона з’явиться тут після підтвердження.</p>
    }
    else
    {
        <ul class="cart-items">
            @foreach (var item in Order.Items)
            {
                <li @key="item.Id">
                    <strong>@item.YachtName</strong>
                    <p>@YachtDraft.DaysText(item.Days) · @item.Crew · яхт: @item.Quantity</p>
                    <div class="cart-line-footer">
                        <MoneyLabel Amount="item.Total" />
                        <button type="button" class="text-button" @onclick="() => ConfirmRemoveAsync(item)"
                                aria-label="@($"Видалити {item.YachtName}")">Видалити</button>
                    </div>
                </li>
            }
        </ul>
        <div class="cart-total" aria-live="polite">
            <span>До сплати</span><strong><MoneyLabel Amount="Order.Total" /></strong>
        </div>
        <button type="button" class="secondary full-width" @onclick="Order.Clear">Очистити кошик</button>
        <a class="button-link checkout-link" href="/checkout">Перевірити замовлення</a>
    }
    <p class="cart-note">Кошик тимчасовий. Замовлення зберігається після підтвердження на окремій сторінці. Оплати немає.</p>
    @if (jsError is not null) { <p role="alert" class="cart-note">@jsError</p> }
</aside>

@code {
    // Підписка на подію сервісу: кошик перемальовується, хоч би хто його змінив.
    protected override void OnInitialized() => Order.Changed += Refresh;

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    // Відписка, щоб сервіс не тримав посилання на вже знищений компонент.
    public void Dispose() => Order.Changed -= Refresh;

    private string? jsError;

    // Рішення про видалення ухвалює C#; JS лише показує стандартний діалог браузера.
    private async Task ConfirmRemoveAsync(OrderLine item)
    {
        jsError = null;
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/orderTools.js");
            if (await module.InvokeAsync<bool>("confirmRemoval", item.YachtName))
                Order.Remove(item.Id);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { jsError = "Не вдалося відкрити підтвердження. Позицію не видалено."; }
    }
}
